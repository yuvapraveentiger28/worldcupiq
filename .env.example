# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Where to find these:
#   DATABRICKS_HOST  - your workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
#   DATABRICKS_TOKEN - User Settings > Developer > Access tokens > Generate new token

DATABRICKS_HOST=
DATABRICKS_TOKEN=
